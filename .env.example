# LLM Provider Configuration
# At least one provider must be configured for LLM features
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# For open-source models via Ollama/vLLM/Groq
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=llama3

# Default model selection
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# Database
DATABASE_URL=postgresql+psycopg://planpilot:planpilot@localhost:5432/planpilot
# For development/testing without Postgres:
# DATABASE_URL=sqlite:///planpilot.db

# Redis (for async job queue)
REDIS_URL=redis://localhost:6379

# API
API_KEY=dev-api-key-change-me
API_HOST=0.0.0.0
API_PORT=8000

# Solver defaults
SOLVER_TIME_LIMIT_SECONDS=60
SOLVER_NUM_WORKERS=8
